# Anthropic (provider: anthropic)
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI-compatible endpoint (provider: openai), e.g. Ollama / vLLM / OpenAI
OPENAI_API_KEY=
# Keys clients must send in the X-API-Key header (comma separated, empty = open)
PROPOSAL_REVIEWER_API_KEYS=
# Key required for creating/updating/deleting skills via the API (empty = disabled)
PROPOSAL_REVIEWER_ADMIN_KEY=
